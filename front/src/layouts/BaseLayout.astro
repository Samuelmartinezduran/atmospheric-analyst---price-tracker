---
/**
 * Documento base: tema antes de pintar (/theme.js, síncrono), fuentes servidas por la app
 * (solo el subconjunto latino) y navegación sin recargas con ClientRouter.
 */
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import {ClientRouter} from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {title, description = 'Seguimiento personal de precios en Amazon ES y PCComponentes.'} = Astro.props;
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Geist';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geistUrl}) format('woff2-variations');unicode-range:${LATIN}}
@font-face{font-family:'Geist Mono';font-style:normal;font-display:swap;font-weight:100 900;src:url(${geistMonoUrl}) format('woff2-variations');unicode-range:${LATIN}}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{`${title} · Lowmark`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme.js"></script>
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
    <script>
      // Los emails antiguos enlazaban a /?verify_token=X y /?reset_token=X, en cualquier página.
      import {getLegacyRedirect} from '../lib/legacyRedirect';
      import {replaceLocation} from '../lib/nav';

      const target = getLegacyRedirect(window.location.search);
      if (target) replaceLocation(target);
    </script>
  </body>
</html>
