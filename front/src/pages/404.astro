---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <main class="auth">
    <div class="auth-card">
      <a class="auth-brand" href="/">
        <span class="mark lg" aria-hidden="true"></span>
        Atmospheric Analyst
      </a>
      <div class="panel" style="text-align: center">
        <p class="mono muted" style="margin-bottom: 8px">404</p>
        <h1>No encontramos esta página</h1>
        <p class="lede">Puede que el enlace esté mal o que la página ya no exista.</p>
        <a class="btn block" href="/">Ir a tus productos</a>
      </div>
    </div>
  </main>
</BaseLayout>
