# Copia este fichero a .env y rellena lo marcado como OBLIGATORIO.
# Todas las demás variables tienen un valor por defecto razonable en backend/app/core/config.py.

# --- Entorno -----------------------------------------------------------------
# dev: muestra /api/docs y permite tokens de depuración. prod: exige secretos reales.
APP_ENV=dev
# Solo en dev: devuelve los tokens de verificación/recuperación en la respuesta
# para poder probar sin servidor de correo. Con APP_ENV=prod se ignora.
AUTH_ENABLE_DEBUG_TOKENS=true
# Dirección desde la que abres la app. Se usa en los enlaces de los emails.
PUBLIC_BASE_URL=http://localhost:8001

# --- Base de datos (OBLIGATORIO) ---------------------------------------------
POSTGRES_USER=tracker
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=tracker

# --- Sesiones (OBLIGATORIO fuera de dev) --------------------------------------
# Mínimo 32 caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# Ponlo a true si sirves la app por HTTPS.
AUTH_COOKIE_SECURE=false
# Solo si hay un proxy inverso de confianza delante (Caddy, Nginx, Cloudflare Tunnel...).
TRUST_PROXY_HEADERS=false

# --- Correo --------------------------------------------------------------------
# Con false, las alertas se ven en la app pero no se envían.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# En Gmail, una «contraseña de aplicación», no la de tu cuenta.
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Comprobación de precios ----------------------------------------------------
# Cada cuánto se comprueba cada producto.
CHECK_INTERVAL_MINUTES=360
TIMEZONE=Europe/Madrid
# Si Amazon bloquea tu IP con captchas, un proxy residencial lo suele resolver.
SCRAPER_PROXY_SERVER=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=

# --- Puertos en este PC ---------------------------------------------------------
# 127.0.0.1 = solo este PC. Pon 0.0.0.0 para abrirla desde otros dispositivos de tu red.
APP_BIND=127.0.0.1
APP_HOST_PORT=8001
DB_HOST_PORT=5433
